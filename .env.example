# Google Play Integrity API Configuration
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json
GOOGLE_CLOUD_PROJECT_NUMBER=your-project-number

# Server Configuration
PORT=3000
NODE_ENV=production

# Security
JWT_SECRET=your-super-secret-jwt-signing-key-min-32-chars
RESPONSE_SIGNING_KEY=your-super-secret-response-signing-key-min-32-chars

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=10

# Allowed Package Names (comma-separated)
ALLOWED_PACKAGE_NAMES=com.android.hos3green

# Certificate Pinning Hash (Base64 SHA-256 of your server's certificate)
CERTIFICATE_PIN_HASH=sha256/your-certificate-pin-hash